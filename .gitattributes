* text=auto

*.ps1 text eol=crlf
_PROJECT/deploy-hosting.ps1 text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.txt text eol=lf

*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
